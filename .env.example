# Port this proxy listens on (Railway sets this automatically)
PORT=3000

# MySQL service — use private networking if proxy is in the same Railway project
MYSQL_HOST=mysql.railway.internal
MYSQL_PORT=3306

# Target app — use private networking (Laravel, Next.js, or any HTTP service)
# Format: http://<service-name>.railway.internal:<internal-port>
TARGET_URL=http://your-service.railway.internal:8000

# Path used to health-check the app (anything that returns non-5xx)
# Laravel 11: /up  |  Next.js: /  or /api/health
HEALTH_PATH=/

# Public URL of this proxy — used to rewrite Location headers and X-Forwarded-* headers
PROXY_URL=https://your-proxy-domain.com

# How long to wait for each service to wake (milliseconds)
WAKE_TIMEOUT_MS=60000

# Delay between retry probes (milliseconds)
RETRY_INTERVAL_MS=2000

# How long to consider services "warm" before probing again (milliseconds)
WARM_TTL_MS=30000
